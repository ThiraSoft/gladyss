#!/usr/bin/env bash
# Client en ligne de commande du service gladyss : envoie du texte à prononcer sur
# les haut-parleurs de la machine. Le service doit tourner (voir README).
set -e

# Lecture du fichier de configuration utilisateur si présent
CONFIG_FILE=""
if [ -f "$HOME/.config/gladyss/config.json" ]; then
  CONFIG_FILE="$HOME/.config/gladyss/config.json"
fi

CFG_URL=""
CFG_SPEED=""
CFG_VOICE=""
CFG_PITCH=""
CFG_FX=""
CFG_FORCE=""

# cle lit une valeur du fichier de configuration. Six clés plates, chaînes ou
# nombres : un sed ciblé suffit, là où un vrai analyseur JSON demanderait
# l'interpréteur Python que ce projet ne veut plus. Une clé absente ou une
# valeur biscornue rend une chaîne vide, et la valeur par défaut s'applique.
cle() {
  [ -n "$CONFIG_FILE" ] || return 0
  sed -n \
    -e 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    -e 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([0-9][0-9.]*\).*/\1/p' \
    "$CONFIG_FILE" | head -1
}

if [ -n "$CONFIG_FILE" ]; then
  CFG_URL=$(cle addr)
  # addr est une adresse d'écoute, url une adresse complète : la première se
  # préfixe, la seconde se prend telle quelle.
  if [ -n "$CFG_URL" ]; then
    CFG_URL="http://$CFG_URL"
  else
    CFG_URL=$(cle url)
  fi
  CFG_SPEED=$(cle speed)
  CFG_VOICE=$(cle voice)
  CFG_PITCH=$(cle pitch)
  CFG_FX=$(cle fx)
  CFG_FORCE=$(cle force)
fi

SERVICE_URL="${GLADYSS_URL:-${CFG_URL:-http://127.0.0.1:8420}}"
SPEED="${GLADYSS_SPEED:-${CFG_SPEED:-1.0}}"
VOICE="${GLADYSS_VOICE:-${CFG_VOICE:-}}"
PITCH="${GLADYSS_PITCH:-${CFG_PITCH:-}}"
FX="${GLADYSS_FX:-${CFG_FX:-}}"
FORCE="${GLADYSS_FORCE:-${CFG_FORCE:-}}"
STREAM=""
RAW=""

POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --speed|-s) SPEED="$2"; shift 2 ;;
    --voice|-v) VOICE="$2"; shift 2 ;;
    --pitch|-p) PITCH="$2"; shift 2 ;;
    --fx)       FX="$2"; shift 2 ;;
    --force)    FORCE="$2"; shift 2 ;;
    --stream)   STREAM=1; shift ;;
    --raw)      RAW=1; shift ;;
    --stop)     curl -s -X POST "$SERVICE_URL/stop" >/dev/null; exit 0 ;;
    --skip)     curl -s -X POST "$SERVICE_URL/skip" >/dev/null; exit 0 ;;
    --help|-h)
      cat <<'USAGE'
Usage: gladyss [options] <message...>
       echo "message" | gladyss
       mon-modele | gladyss --stream

Options:
  -s, --speed <val>   Vitesse de parole (défaut: 1.0, ou $GLADYSS_SPEED)
  -v, --voice <nom>   Voix à utiliser (gladyss --voices pour la liste)
  -p, --pitch <val>   Hauteur de voix (0.5 à 2.0)
      --fx <nom>      Effet sonore (gladyss --effects pour la liste)
      --force <val>   Force de l'effet (0.0 à 2.0)
      --stream        Lit l'entrée standard au fil de l'eau : chaque phrase
                      part dès qu'elle est finie, sans attendre la fin du texte
      --raw           Avec --stream, dit tout, sans écarter code ni chemins
      --stop          Interrompt la lecture et vide la file
      --skip          Passe à l'énoncé suivant
      --voices        Liste les voix disponibles
      --effects       Liste les effets disponibles

Variables d'environnement : GLADYSS_URL, GLADYSS_SPEED, GLADYSS_VOICE, GLADYSS_PITCH,
GLADYSS_FX, GLADYSS_FORCE — mêmes valeurs que les options correspondantes.
USAGE
      exit 0 ;;
    --voices)  curl -s "$SERVICE_URL/voices"; echo; exit 0 ;;
    --effects) curl -s "$SERVICE_URL/effects"; echo; exit 0 ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done

if [ -n "$STREAM" ]; then
  # Le texte n'est pas lu ici : il est versé à curl au fur et à mesure.
  TEXT=""
elif [ ${#POSITIONAL[@]} -gt 0 ]; then
  TEXT="${POSITIONAL[*]}"
elif [ ! -t 0 ]; then
  TEXT=$(cat)
else
  echo "Erreur: aucun texte fourni. Utilise 'gladyss \"texte\"' ou 'echo texte | gladyss'" >&2
  exit 1
fi

# Le service est un exécutable qu'on lance soi-même : s'il ne répond pas, on le
# dit plutôt que de deviner où il est installé.
if ! curl -s --max-time 1 "$SERVICE_URL/health" >/dev/null 2>&1; then
  echo "Erreur: aucun service sur $SERVICE_URL." >&2
  echo "Lance-le depuis le dépôt (./gladyss), ou pointe GLADYSS_URL ailleurs." >&2
  exit 1
fi

# Tout passe par l'URL, y compris la force de l'effet : le service accepte
# ?force=, et le texte voyage dans le corps, où il n'a rien à échapper. Plus de
# JSON à fabriquer, donc plus d'interpréteur à invoquer pour ça.
PARAMS=()
[ -n "$SPEED" ] && PARAMS+=("speed=$SPEED")
[ -n "$VOICE" ] && PARAMS+=("voice=$VOICE")
[ -n "$PITCH" ] && PARAMS+=("pitch=$PITCH")
[ -n "$FX" ]    && PARAMS+=("fx=$FX")
[ -n "$FX" ] && [ -n "$FORCE" ] && PARAMS+=("force=$FORCE")
[ -n "$RAW" ]   && PARAMS+=("filter=off")
QUERY=""
if [ ${#PARAMS[@]} -gt 0 ]; then
  QUERY="?"$(IFS='&'; echo "${PARAMS[*]}")
fi
if [ -n "$STREAM" ]; then
  # -T - envoie le corps en morceaux au fil de la lecture ; --data-binary
  # attendrait la fin de l'entrée pour connaître sa taille, ce qui annulerait
  # tout l'intérêt de la chose.
  curl -s --no-buffer -X POST -T - "$SERVICE_URL/say/stream$QUERY" >/dev/null
else
  curl -s -X POST "$SERVICE_URL/say$QUERY" -d "$TEXT" >/dev/null
fi
