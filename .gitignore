# Environnement Python et artefacts de build
.venv/
__pycache__/
# Le binaire construit, à la racine seulement : cli/gladyss est un fichier du dépôt.
/gladyss
/.install-check.log

# Voix clonées : échantillons et états de modèle. Ce sont des enregistrements
# de personnes réelles, ils n'ont rien à faire dans un dépôt public. Le contenu
# est ignoré, pas le répertoire : .gitkeep le fait exister à la sortie du clone,
# là où le service ira chercher les voix locales.
voix/*
!voix/.gitkeep
*.wav
*.safetensors

# Archives de transfert : elles emportent voix/ avec elles.
*.tar.gz

# Résidus macOS
.DS_Store
._*

# Configuration d'agents locale : elle contient des chemins absolus propres à
# la machine, et n'a de sens que pour son propriétaire.
.agents/

# Journaux et PID d'exécutions manuelles
*.log
.gladyss.pid
nohup.out

# Les specs et plans de travail : utiles pendant, pas après.
/docs/superpowers/
